@AbapCatalog.compiler.compareFilter: true
@AbapCatalog.preserveKey: true
@AbapCatalog.sqlViewName: 'ZEM_MBPCUSTKNVI'

@AccessControl.authorizationCheck: #NOT_REQUIRED

@EndUserText.label: 'Customer KNVI'

@ObjectModel.usageType: { serviceQuality: #X, sizeCategory: #XL, dataClass: #MIXED }

define view ZIM_MASS_BP_CUST_TAX
  as select from knvi

    inner join   kna1   as _kna1   on knvi.kunnr = _kna1.kunnr
    inner join   but000 as _but000 on knvi.kunnr = _but000.partner

{
  key _but000.partner          as PARTNER,
  key knvi.aland               as ALAND,
  key knvi.tatyp               as TATYP,

      knvi.kunnr               as KUNNR,
      _kna1.zz1_crreason_cus   as zz1_crreason_cus,
      _but000.type             as Type,
      _but000.bpkind           as Bpkind,
      _but000.bu_group         as Bu_Group,
      _but000.bpext            as Bpext,
      _but000.bu_sort1         as Bu_Sort1,
      _but000.bu_sort2         as Bu_Sort2,
      _but000.source           as Source,
      _but000.title            as Title,
      _but000.xdele            as Xdele,
      _but000.xblck            as Xblck,
      _but000.augrp            as Augrp,
      _but000.title_let        as Title_Let,
      _but000.bu_logsys        as Bu_Logsys,
      _but000.contact          as Contact,
      _but000.not_released     as Not_Released,
      _but000.not_lg_competent as Not_Lg_Competent,
      _but000.print_mode       as Print_Mode,
      _but000.bp_eew_dummy     as Bp_Eew_Dummy,
      _but000.rate             as Rate,
      _but000.name_org1        as Name_Org1,
      _but000.name_org2        as Name_Org2,
      _but000.name_org3        as Name_Org3,
      _but000.name_org4        as Name_Org4,
      _but000.legal_enty       as Legal_Enty,
      _but000.ind_sector       as Ind_Sector,
      _but000.legal_org        as Legal_Org,
      _but000.dc_not_req       as Dc_Not_Req,
      _but000.found_dat        as Found_Dat,
      _but000.liquid_dat       as Liquid_Dat,
      _but000.location_1       as Location_1,
      _but000.location_2       as Location_2,
      _but000.location_3       as Location_3,
      _but000.name_last        as Name_Last,
      _but000.name_first       as Name_First,
      _but000.name_lst2        as Name_Lst2,
      _but000.name_last2       as Name_Last2,
      _but000.namemiddle       as Name_middle,
      _but000.title_aca1       as Title_Aca1,
      _but000.title_aca2       as Title_Aca2,
      _but000.title_royl       as Title_Royl,
      _but000.prefix1          as Prefix1,
      _but000.prefix2          as Prefix2,
      _but000.name1_text       as Name1_Text,
      _but000.nickname         as Nickname,
      _but000.initials         as Initials,
      _but000.nameformat       as Nameformat,
      _but000.namcountry       as Namcountry,
      _but000.langu_corr       as Langu_Corr,
      _but000.xsexm            as Xsexm,
      _but000.xsexf            as Xsexf,
      _but000.birthpl          as Birthpl,
      _but000.marst            as Marst,
      _but000.emplo            as Emplo,
      _but000.jobgr            as Jobgr,
      _but000.natio            as Natio,
      _but000.cntax            as Cntax,
      _but000.cndsc            as Cndsc,
      _but000.persnumber       as Persnumber,
      _but000.xsexu            as Xsexu,
      _but000.xubname          as Xubname,
      _but000.bu_langu         as Bu_Langu,
      _but000.gender           as Gender,
      _but000.birthdt          as Birthdt,
