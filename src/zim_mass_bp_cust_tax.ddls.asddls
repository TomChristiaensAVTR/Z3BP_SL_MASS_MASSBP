      _but000.data_ctrlr10     as Data_Ctrlr10,
      _but000.xdcset           as Xdcset,
      _but000./ceeib/sk_resid  as /ceeib/sk_Resid,
      _but000.bank_area        as BankArea,
      _but000.credit_tax_code  as Credit_Tax_Code,
      _but000.debit_tax_code   as Debit_Tax_Code,
      _but000.credit_tax_type  as Credit_Tax_Type,
      _but000.debit_tax_type   as Debit_Tax_Type,
      _but000.natpers          as Natpers,
      _but000.milve            as Milve,
      _but000.nuc_sec          as Nuc_Sec,
      _but000.par_rel          as Par_Rel,
      _but000.bp_sort          as Bp_Sort,
      _but000.kbanks           as Kbanks,
      _but000.kbankl           as Kbankl,
      knvi.taxkd               as Taxkd
}
