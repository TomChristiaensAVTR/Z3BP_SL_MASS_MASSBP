      _but000.crtim            as Crtim,
      _but000.chusr            as Chusr,
      _but000.chdat            as Chdat,
      _but000.chtim            as Chtim,
      _but000.partner_guid     as PartnervGuid,
      _but000.addrcomm         as Addrcomm,
      _but000.td_switch        as Td_Switch,
      _but000.is_org_centre    as Is_Org_Centre,
      _but000.db_key           as Db_Key,
