define view ZIM_MASS_BP_VEND_PURCHASING
  as select from lfm1

    inner join   lfa1   as _lfa1   on lfm1.lifnr = _lfa1.kunnr
    inner join   but000 as _but000 on lfm1.lifnr = _but000.partner

{
  key _but000.partner          as PARTNER,
  key lfm1.ekorg               as EKORG,

