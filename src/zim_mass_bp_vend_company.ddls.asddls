@EndUserText.label: 'Vendor LFB1'

@ObjectModel.usageType: { serviceQuality: #X, sizeCategory: #XL, dataClass: #MIXED }

define view ZIM_MASS_BP_VEND_COMPANY
  as select from lfb1

    inner join   lfa1   as _lfa1   on lfb1.lifnr = _lfa1.kunnr
    inner join   but000 as _but000 on lfb1.lifnr = _but000.partner
    inner join   t001   as _t001   on lfb1.bukrs = _t001.bukrs

{
  key _but000.partner           as PARTNER,
  key lfb1.bukrs                as BUKRS,

